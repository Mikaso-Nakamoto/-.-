# Telegram Bot
TELEGRAM_BOT_TOKEN=123456789:AAFg...
TELEGRAM_ADMIN_ID=123456789

# Часовой пояс (по умолчанию Московское время Europe/Moscow, UTC+3)
# Примеры: Europe/Moscow, Europe/Samara, Asia/Yekaterinburg, Asia/Novosibirsk, Europe/Stockholm
TZ=Europe/Moscow

# Режим тестирования (тумблер: 1 = не помечать новости как прочитанные, не засорять базу; 0 = боевой режим)
TEST_MODE=1

# Локальный ПК с RTX 2060 Super (Qwen 2.5 7B в LM Studio)
# В LM Studio включите вкладку Local Server -> "Start Server" и включите галочку "Serve on Local Network"
# Укажите локальный IP вашего основного компьютера в домашней сети (порт 1234 по умолчанию)
LOCAL_QWEN_URL=http://192.168.1.150:1234/v1

# Облачные API (по желанию, для резерва и переключения)
GROQ_API_KEY=gsk_...
GEMINI_API_KEY=AIzaSy...
OPENROUTER_API_KEY=sk-or-v1-...
